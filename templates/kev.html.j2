{% extends "base.html.j2" %}
{% import "_components.j2" as ui %}
{% block title %}Known exploited vulnerabilities &mdash; Threat Intel Pipeline{% endblock %}
{% block content %}
<h1 class="page-title">Known exploited vulnerabilities</h1>
<p class="muted">
  CISA's KEV catalog (vulnerabilities confirmed exploited in the wild), enriched with FIRST EPSS
  exploit-probability scores. Catalog {{ kev.catalog_version }} &middot; updated {{ kev.generated_at }} UTC.
  EPSS data may lag by a day.
</p>

<section class="cards" aria-label="Vulnerability priority">
  <div class="card">
    <div class="card-head">{{ ui.icon("shield") }}Tracked</div>
    <span class="num">{{ kev.entries | length }}</span>
    <span class="card-sub">of {{ kev.catalog_count }} in the catalog</span>
  </div>
  <div class="card{% if kev.ransomware %} card-bad{% endif %}">
    <div class="card-head">{{ ui.icon("alert") }}Ransomware</div>
    <span class="num">{{ kev.ransomware }}</span>
    <span class="card-sub">known ransomware campaigns</span>
  </div>
  <div class="card{% if kev.overdue %} card-bad{% endif %}">
    <div class="card-head">{{ ui.icon("alert") }}Overdue</div>
    <span class="num">{{ kev.overdue }}</span>
    <span class="card-sub">past the KEV due date</span>
  </div>
  <div class="card">
    <div class="card-head">{{ ui.icon("arrow-up") }}EPSS &ge; 50%</div>
    <span class="num">{{ kev.epss_high }}</span>
    <span class="card-sub">high exploit probability</span>
  </div>
  {% if kev.org.enabled %}
  <div class="card">
    <div class="card-head">{{ ui.icon("shield") }}In your stack</div>
    <span class="num">{{ kev.matches }}</span>
    <span class="card-sub">KEV entries matching your technologies</span>
  </div>
  {% endif %}
</section>

<section>
  <h2>{{ ui.icon("list") }}Vulnerabilities (newest first)</h2>
  {% if kev.entries %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">CVE</th><th scope="col">Vendor</th><th scope="col">Product</th>
          <th scope="col">Vulnerability</th><th scope="col">Added</th><th scope="col">Due</th>
          <th scope="col">Ransom</th><th scope="col" class="num-col">EPSS</th>
          {% if kev.org.enabled %}<th scope="col">Environment</th>{% endif %}
          <th scope="col">Reports</th>
        </tr>
      </thead>
      <tbody>
      {% for e in kev.entries %}
        <tr id="{{ e.cve }}">
          <td><a href="https://nvd.nist.gov/vuln/detail/{{ e.cve }}" target="_blank" rel="noopener"><code>{{ e.cve }}</code></a></td>
          <td><a href="https://nvd.nist.gov/vuln/search/results?query={{ e.vendor | urlencode }}&amp;search_type=all" target="_blank" rel="noopener">{{ e.vendor }}</a></td>
          <td><a href="https://nvd.nist.gov/vuln/search/results?query={{ e.product | urlencode }}&amp;search_type=all" target="_blank" rel="noopener">{{ e.product }}</a></td>
          <td><a href="https://nvd.nist.gov/vuln/detail/{{ e.cve }}" target="_blank" rel="noopener">{{ e.name }}</a></td>
          <td>{{ e.date_added }}</td>
          <td>{{ e.due_date }}{% if e.overdue %} <span class="pill err">overdue</span>{% endif %}</td>
          <td>{% if e.ransomware %}<span class="pill err">known</span>{% else %}<span class="muted">&mdash;</span>{% endif %}</td>
          <td class="num-cell">{% if e.epss is not none %}{{ "%.1f%%" | format(e.epss * 100) }}{% else %}&mdash;{% endif %}</td>
          {% if kev.org.enabled %}
          <td>{% if e.matched %}<span class="pill ok" title="{{ e.matched | join(', ') }}">matched</span>{% else %}<span class="muted">&mdash;</span>{% endif %}</td>
          {% endif %}
          <td>{% if e.reports %}<a href="report-{{ e.reports[0].id }}.html" title="{{ e.reports[0].title }}">{{ e.reports | length }} report(s)</a>{% else %}<span class="muted">&mdash;</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="muted">EPSS = probability of exploitation activity in the next 30 days (0&ndash;100%); see first.org/epss.</p>
  {% else %}
  <p class="muted">No KEV data yet &mdash; the next sync will populate this page.</p>
  {% endif %}
</section>
{% endblock %}
