{% extends "base.html.j2" %}
{% import "_components.j2" as ui %}
{% block title %}Report feed &mdash; Threat Intel Pipeline{% endblock %}
{% block head_extra %}
<style>
{% for c in reports.categories -%}
#f-{{ c.id }}:checked ~ .report-grid .report-card:not(.cat-{{ c.id }}){display:none}
{% endfor -%}
{% for c in ([{'id': 'all'}] + reports.categories) -%}
#f-{{ c.id }}:checked ~ .filterbar label[for="f-{{ c.id }}"]{background:var(--color-primary);border-color:var(--color-primary);color:var(--color-on-primary);font-weight:600}
#f-{{ c.id }}:focus-visible ~ .filterbar label[for="f-{{ c.id }}"]{outline:2px solid var(--color-ring);outline-offset:2px}
{% endfor -%}
</style>
{% endblock %}
{% block content %}
<h1 class="page-title">Threat intelligence report feed</h1>
<p class="muted">
  Advisories and vendor research from multiple sources. Indicators per report are extracted
  automatically and defanged &mdash; validate before blocking. Filter by category or search across
  titles, summaries, tags and sources. Last updated {{ reports.generated_at }} UTC.
</p>

<section>
  {% for c in ([{'id': 'all'}] + reports.categories) -%}
  <input type="radio" name="cat" id="f-{{ c.id }}" class="vh report-filter"{% if c.id == 'all' %} checked{% endif %}>
  {% endfor -%}
  <div class="filterbar" role="group" aria-label="Filter reports by category">
    <label for="f-all">All ({{ reports.total }})</label>
    {% for c in reports.categories %}<label for="f-{{ c.id }}">{{ c.label }} ({{ c.count }})</label>{% endfor %}
    <input id="rsearch" type="search" placeholder="Search reports (title, summary, tags, source)&hellip;" aria-label="Search reports">
    <span class="report-count" id="rcount" aria-live="polite"></span>
  </div>

  {% if reports.entries %}
  <div class="report-grid">
    {% for r in reports.entries %}
    <article class="report-card cat-{{ r.category }}" data-search="{{ (r.title ~ ' ' ~ (r.summary or '') ~ ' ' ~ r.source_name ~ ' ' ~ r.label ~ ' ' ~ ((r.tags or []) | join(' ')))|lower }}">
      <div class="badges">
        <span class="badge badge-cat">{{ r.label }}</span>
        <span class="badge">{{ r.source_name }}</span>
        {% if r.risk %}<span class="risk risk-{{ r.risk.level }}">{{ r.risk.level }}</span>{% endif %}
        {% if r.org_matches %}<span class="badge badge-env">in your stack</span>{% endif %}
        {% if r.curated %}<span class="badge badge-curated">curated</span>{% endif %}
      </div>
      <h3><a href="report-{{ r.id }}.html">{{ r.title }}</a></h3>
      {% if r.summary %}<p class="excerpt">{{ r.summary }}</p>{% endif %}
      {% if r.tags or r.technique_links %}
      <div class="chip-list small">
        {% for t in r.tags %}<span class="chip">{{ t }}</span>{% endfor %}
        {% for t in r.technique_links %}<span class="chip"><a href="{{ t.url }}" rel="noopener">{{ t.id }}</a></span>{% endfor %}
      </div>
      {% endif %}
      <div class="report-meta">
        <span>{{ r.published[:10] if r.published else (r.fetched[:10] if r.fetched else "") }}</span>
        <span>
          {% if r.iocs %}<a href="report-{{ r.id }}.html#iocs">{{ r.ioc_summary or (r.iocs | length ~ " IOCs") }}</a>{% endif %}
          {% if r.iocs and r.recommendations %} &middot; {% endif %}
          {% if r.recommendations %}<a href="report-{{ r.id }}.html#recommendations">{{ r.recommendations | length }} recs</a>{% endif %}
        </span>
      </div>
    </article>
    {% endfor %}
  </div>
  <p class="muted" id="rnoresults" style="display:none">No reports match your search.</p>
  {% else %}
  <p class="muted">No reports yet &mdash; the next sync will populate the feed.</p>
  {% endif %}
</section>

<script>
(function () {
  var input = document.getElementById("rsearch");
  var grid = document.querySelector(".report-grid");
  if (!input || !grid) { return; }
  var cards = Array.prototype.slice.call(grid.querySelectorAll(".report-card"));
  var count = document.getElementById("rcount");
  var empty = document.getElementById("rnoresults");

  function apply() {
    var query = input.value.trim().toLowerCase();
    cards.forEach(function (card) {
      var text = card.getAttribute("data-search") || "";
      card.style.display = (!query || text.indexOf(query) >= 0) ? "" : "none";
    });
    var visible = cards.filter(function (card) { return card.offsetParent !== null; }).length;
    if (count) { count.textContent = visible + " of " + cards.length + " reports"; }
    if (empty) { empty.style.display = visible === 0 ? "" : "none"; }
  }

  var timer;
  input.addEventListener("input", function () { clearTimeout(timer); timer = setTimeout(apply, 120); });
  Array.prototype.forEach.call(document.querySelectorAll(".report-filter"), function (radio) {
    radio.addEventListener("change", apply);
  });
  apply();
})();
</script>
{% endblock %}
