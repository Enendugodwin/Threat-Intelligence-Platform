<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Threat Intel Pipeline{% endblock %}</title>
<style>
:root{--bg:#0d1117;--panel:#161b22;--border:#30363d;--text:#e6edf3;--muted:#8b949e;--accent:#58a6ff;--good:#3fb950;--bad:#f85149}
*{box-sizing:border-box}
body{margin:0;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;background:var(--bg);color:var(--text);line-height:1.5}
header{padding:1.5rem 2rem;border-bottom:1px solid var(--border)}
header h1{margin:0 0 .25rem;font-size:1.4rem}
header h1 a{color:var(--text);text-decoration:none}
header p{margin:0;color:var(--muted);font-size:.85rem}
nav{margin-top:.5rem;font-size:.85rem}
nav a{color:var(--accent);text-decoration:none;margin-right:1rem}
main{padding:2rem;max-width:1200px;margin:0 auto}
section{margin-bottom:2rem}
h2{font-size:1rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);border-bottom:1px solid var(--border);padding-bottom:.4rem}
table{width:100%;border-collapse:collapse;font-size:.85rem}
th,td{text-align:left;padding:.4rem .6rem;border-bottom:1px solid var(--border);vertical-align:top}
th{color:var(--muted);font-weight:600}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;margin-bottom:2rem}
.card{background:var(--panel);border:1px solid var(--border);border-radius:8px;padding:1rem}
.card .num{display:block;font-size:1.6rem;color:var(--accent)}
.card .lbl{color:var(--muted);font-size:.8rem;text-transform:uppercase}
.ok{color:var(--good)}.err{color:var(--bad)}
.muted{color:var(--muted);font-size:.85rem}
code{color:var(--text)}
footer{padding:1rem 2rem 2rem;color:var(--muted);font-size:.8rem;border-top:1px solid var(--border)}
footer a,main a{color:var(--accent)}
</style>
</head>
<body>
<header>
  <h1><a href="index.html">Threat Intel Pipeline</a></h1>
  <p>{{ totals.total }} indicators tracked &middot; {{ totals.new }} new in the last {{ window_days }} days &middot; generated {{ generated_at }} UTC</p>
  <nav>
    <a href="index.html">Dashboard</a>
    <a href="report.html">Latest report</a>
    {% if repo_url %}<a href="{{ repo_url }}" rel="noopener">GitHub</a>{% endif %}
  </nav>
</header>
<main>
{% block content %}{% endblock %}
</main>
<footer>
  <p>Sources: URLhaus &middot; Feodo Tracker &middot; ThreatFox &middot; AlienVault OTX. Indicators are defanged for safe display.</p>
  <p>Generated by <a href="{{ repo_url }}" rel="noopener">threat-intel-pipeline</a> at {{ generated_at }} UTC.</p>
</footer>
</body>
</html>
