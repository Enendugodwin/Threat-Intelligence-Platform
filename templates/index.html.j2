{% extends "base.html.j2" %}
{% import "_components.j2" as ui %}
{% block title %}Dashboard &mdash; Threat Intel Pipeline{% endblock %}
{% block content %}
<div class="page-heading">
  <div>
    <h1 class="page-title">Threat Intelligence Overview</h1>
    <p class="muted">{{ totals.total }} tracked indicators &middot; {{ feed_health.ok }}/{{ feed_health.total }} active feeds healthy</p>
  </div>
  <div class="page-actions" aria-label="Export threat intelligence">
    <a class="action-link" href="iocs.json" download>Download JSON</a>
    <a class="action-link" href="iocs.csv" download>Download CSV</a>
    <a class="action-link primary" href="report.html">Report / PDF</a>
  </div>
</div>
{{ ui.cards(totals, feed_health, tor, window_days) }}

{{ ui.action_queue(action_queue) }}

{{ ui.feed_health_section(feed_health) }}

<section>
  <h2>{{ ui.icon("database") }}Indicators by type</h2>
  {{ ui.bars(by_type, window_days) }}
</section>

{{ ui.families_section(families) }}

{{ ui.attack_section(coverage) }}

{{ ui.tor_section(tor) }}

{{ ui.notable_section(notable) }}
{% endblock %}
