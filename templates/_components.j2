{# Inline SVG icons (Lucide-style, single family, stroke 1.75) - decorative, aria-hidden #}
{% macro icon(name, size=16) -%}
<svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- if name == "shield" -%}
<path d="M12 3l7 3v5c0 4.4-2.9 7.5-7 9-4.1-1.5-7-4.6-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>
{%- elif name == "database" -%}
<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5"/><path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/>
{%- elif name == "pulse" -%}
<path d="M3 12h4l2.5-6 4.5 12 2.5-6H21"/>
{%- elif name == "grid" -%}
<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>
{%- elif name == "target" -%}
<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 1v3M12 20v3M1 12h3M20 12h3"/>
{%- elif name == "alert" -%}
<path d="M12 3.5l9.5 16.5H2.5z"/><path d="M12 10v5"/><path d="M12 18h.01"/>
{%- elif name == "eye-off" -%}
<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/><path d="M4 4l16 16"/>
{%- elif name == "list" -%}
<path d="M8 6h13M8 12h13M8 18h13"/><circle cx="3.5" cy="6" r="1"/><circle cx="3.5" cy="12" r="1"/><circle cx="3.5" cy="18" r="1"/>
{%- elif name == "dashboard" -%}
<rect x="3" y="3" width="8" height="10" rx="1.5"/><rect x="13" y="3" width="8" height="6" rx="1.5"/><rect x="13" y="11" width="8" height="10" rx="1.5"/><rect x="3" y="15" width="8" height="6" rx="1.5"/>
{%- elif name == "arrow-up" -%}
<path d="M12 19V5"/><path d="M5 12l7-7 7 7"/>
{%- endif -%}
</svg>
{%- endmacro %}

{% macro export_menu() -%}
<details class="export-menu">
  <summary class="action-button primary" aria-label="Choose report export format">
    Export
    <svg class="icon export-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
  </summary>
  <div class="export-menu-panel" role="group" aria-label="Download report">
    <a href="iocs.csv" download><span class="export-format">CSV</span><span class="export-description">Indicator data</span></a>
    <a href="iocs.json" download><span class="export-format">JSON</span><span class="export-description">Indicator data</span></a>
    <a href="report.html?print=1"><span class="export-format">PDF report</span><span class="export-description">Opens print / Save as PDF</span></a>
  </div>
</details>
{%- endmacro %}

{% macro bars(by_type, window_days) -%}
{% if by_type %}
{% set max_total = (by_type | map(attribute='total') | max) or 1 %}
<div class="bars">
  {% for t in by_type %}
  <div class="bar-row">
    <span class="bar-label"><a href="iocs-{{ t.type }}.html">{{ t.type }}</a></span>
    <span class="bar-track" aria-hidden="true"><span class="bar-fill" style="width: {{ (t.total / max_total * 100) | round(1) }}%"></span></span>
    <span class="bar-value">{{ t.total }}{% if t.new %} <span class="new">+{{ t.new }}</span>{% endif %}</span>
  </div>
  {% endfor %}
</div>
{% else %}
<p class="muted">No indicators yet.</p>
{% endif %}
{%- endmacro %}

{% macro cards(totals, feed_health, tor, window_days) -%}
<section class="cards" aria-label="Key metrics">
  <div class="card">
    <div class="card-head">{{ icon("database") }}Indicators tracked</div>
    <span class="num">{{ totals.total }}</span>
    <span class="card-sub">{{ totals.high_confidence }} at confidence &ge; 80</span>
  </div>
  <div class="card">
    <div class="card-head">{{ icon("arrow-up") }}New this run</div>
    <span class="num">{{ totals.new_run }}</span>
    <span class="card-sub">{{ totals.updated_run }} updated &middot; {{ totals.pruned_run }} pruned</span>
  </div>
  <div class="card">
    <div class="card-head">{{ icon("pulse") }}Last {{ window_days }} days</div>
    <span class="num">{{ totals.activity_new }}</span>
    <span class="card-sub">{{ totals.activity_updated }} updated &middot; {{ totals.activity_runs }} sync run(s)</span>
  </div>
  <div class="card{% if feed_health.ok < feed_health.total %} card-bad{% endif %}">
    <div class="card-head">{{ icon("pulse") }}Feeds healthy</div>
    <span class="num">{{ feed_health.ok }}/{{ feed_health.total }}</span>
    <span class="card-sub">last run</span>
  </div>
  <div class="card">
    <div class="card-head">{{ icon("shield") }}KEV tracked</div>
    <span class="num">{{ kev_summary.total if kev_summary is defined and kev_summary else "—" }}</span>
    <span class="card-sub">{% if kev_summary is defined and kev_summary %}{{ kev_summary.ransomware }} ransomware &middot; {{ kev_summary.overdue }} overdue{% if kev_summary.matches is defined and kev_summary.matches %} &middot; {{ kev_summary.matches }} in your stack{% endif %}{% else %}see Vulnerabilities{% endif %}</span>
  </div>
  <div class="card">
    <div class="card-head">{{ icon("eye-off") }}Tor nodes</div>
    <span class="num">{{ tor.total }}</span>
    <span class="card-sub">{{ tor.exits }} exits / {{ tor.relays }} relays</span>
  </div>
</section>
{%- endmacro %}

{% macro feed_health_section(feed_health) -%}
<section>
  <h2>{{ icon("pulse") }}Feed health</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th scope="col">Feed</th><th scope="col" class="num-col">Records</th><th scope="col" class="num-col">&Delta;</th><th scope="col" class="num-col">Duration</th><th scope="col">Status</th></tr>
      </thead>
      <tbody>
      {% for f in feed_health.feeds %}
        <tr>
          <td><code>{{ f.label }}</code></td>
          <td class="num-cell">{{ f.count if f.count is not none else "—" }}</td>
          <td class="num-cell">{% if f.delta is none %}&mdash;{% elif f.delta > 0 %}+{{ f.delta }}{% else %}{{ f.delta }}{% endif %}</td>
          <td class="num-cell">{% if f.duration is not none %}{{ f.duration }}s{% else %}&mdash;{% endif %}</td>
          <td>
            {% if f.error %}<span class="pill err">error</span> <span class="err-text">{{ f.error }}</span>
            {% else %}<span class="pill ok">ok</span>{% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="muted">Last run {{ feed_health.last_run_at or "—" }} UTC &middot; &Delta; compares with the previous run.</p>
</section>
{%- endmacro %}

{% macro tor_section(tor) -%}
<section>
  <h2>{{ icon("eye-off") }}Tor relay / exit nodes</h2>
  {% if tor.total %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th scope="col">Metric</th><th scope="col" class="num-col">Value</th></tr>
      </thead>
      <tbody>
        <tr><td>Nodes tracked</td><td class="num-cell">{{ tor.total }}</td></tr>
        <tr><td>Exit nodes</td><td class="num-cell">{{ tor.exits }}</td></tr>
        <tr><td>Other relays</td><td class="num-cell">{{ tor.relays }}</td></tr>
        <tr><td>New in window</td><td class="num-cell">{{ tor.new }}</td></tr>
      </tbody>
    </table>
  </div>
  {% if tor.sample %}
  <p class="muted" style="margin-top: var(--space-lg)">Sample ({{ tor.sample | length }} of {{ tor.total }}, source {{ tor.source }}):</p>
  <div class="chip-list">
    {% for ip in tor.sample %}<span class="chip">{{ ip }}</span>{% endfor %}
  </div>
  {% endif %}
  {% if tor.download_url %}
  <p style="margin-top: var(--space-lg)"><a class="action-link primary no-print" href="{{ tor.download_url }}" download>Download all Tor nodes (.txt)</a></p>
  <p class="muted">One address per line, including relays and exits.</p>
  {% endif %}
  {% else %}
  <p class="muted">No Tor node data this run.</p>
  {% endif %}
</section>
{%- endmacro %}

{% macro notable_section(notable) -%}
<section>
  <h2>{{ icon("alert") }}Notable new indicators</h2>
  {% if notable %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th scope="col">Indicator (defanged)</th><th scope="col">Type</th><th scope="col">Risk</th><th scope="col" class="num-col">Hits</th><th scope="col">Family</th><th scope="col">Sources</th><th scope="col">First seen</th><th scope="col" class="num-col">Conf.</th></tr>
      </thead>
      <tbody>
      {% for i in notable %}
        <tr>
          <td><a href="{{ i.href }}" target="_blank" rel="noopener"><code>{{ i.value }}</code></a></td>
          <td>{{ i.type }}</td>
          <td><span class="risk risk-{{ i.risk.level }}">{{ i.risk.level }} {{ i.risk.score }}</span></td>
          <td class="num-cell">{% if i.hits %}<span class="pill err">{{ i.hits.count }}</span>{% else %}&mdash;{% endif %}</td>
          <td>{{ i.malware if i.malware else "—" }}</td>
          <td>{{ i.sources | join(", ") }}</td>
          <td>{{ i.first_seen if i.first_seen else "—" }}</td>
          <td class="num-cell">{{ i.confidence }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="muted">Values are defanged; clicking opens a VirusTotal lookup in a new tab.</p>
  {% else %}
  <p class="muted">No new indicators in the window.</p>
  {% endif %}
</section>
{%- endmacro %}

{% macro families_section(families) -%}
<section>
  <h2>{{ icon("grid") }}Top malware families</h2>
  {% if families %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th scope="col">Family</th><th scope="col" class="num-col">Indicators</th><th scope="col" class="num-col">New</th><th scope="col">ATT&amp;CK (heuristic)</th></tr>
      </thead>
      <tbody>
      {% for f in families %}
        <tr>
          <td><a href="family-{{ f.slug }}.html">{{ f.name }}</a></td>
          <td class="num-cell">{{ f.total }}</td>
          <td class="num-cell">{{ f.new }}</td>
          <td>{% if f.techniques %}<span class="chip-list">{% for t in f.techniques %}<span class="chip">{{ t }}</span>{% endfor %}</span>{% else %}—{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p class="muted">No malware-family annotations yet.</p>
  {% endif %}
</section>
{%- endmacro %}

{% macro attack_section(coverage) -%}<section>
  <h2>{{ icon("target") }}ATT&amp;CK coverage<span class="count">&nbsp;({{ coverage | length }} techniques)</span></h2>
  {% if coverage %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th scope="col">Technique</th><th scope="col">Name</th><th scope="col">Tactics</th><th scope="col" class="num-col">Indicators</th></tr>
      </thead>
      <tbody>
      {% for t in coverage %}
        <tr>
          <td><a href="technique-{{ t.id }}.html"><code>{{ t.id }}</code></a></td>
          <td>{{ t.name }}</td>
          <td>{{ t.tactics | join(", ") }}</td>
          <td class="num-cell">{{ t.primary }}{% if t.basis.heuristic %} <span class="muted">+{{ t.basis.heuristic }} heuristic</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="muted">Counts show family/tag evidence; "+N heuristic" are bare network indicators mapped by the default heuristic (T1071.001) and are excluded from the headline count.</p>
  {% else %}
  <p class="muted">No technique mapping yet.</p>
  {% endif %}
</section>
{%- endmacro %}

{% macro action_queue(items) -%}
{% if items %}
<section>
  <h2>{{ icon("alert") }}Action queue<span class="count">&nbsp;({{ items | length }} priorities)</span></h2>
  <div class="queue">
    {% for item in items %}
    <article class="queue-item">
      <span class="risk risk-{{ item.level }}">{{ item.level }}</span>
      <div class="queue-body">
        <strong class="queue-title">{{ item.title }}</strong>
        <span class="queue-why">{{ item.why }}</span>
      </div>
      <span class="queue-actions">
        <a href="{{ item.href }}">Investigate</a>
        {% if item.external %}<a href="{{ item.external }}" target="_blank" rel="noopener">Lookup</a>{% endif %}
      </span>
    </article>
    {% endfor %}
  </div>
</section>
{% endif %}
{%- endmacro %}
