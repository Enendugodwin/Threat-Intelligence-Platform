{% extends "base.html.j2" %}
{% import "_components.j2" as ui %}
{% block title %}Possible attack origins &mdash; Threat Intel Pipeline{% endblock %}
{% block head_extra %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>#map{height:540px;border:1px solid var(--color-border);border-radius:var(--radius);background:var(--color-card);z-index:1}</style>
{% endblock %}
{% block content %}
<h1 class="page-title">Possible attack origins</h1>
<p class="muted">
  Approximate geolocation of C2 and infrastructure indicators
  {% if geo.sources %}(sources: {{ geo.sources | join(", ") }}){% endif %}.
  {{ geo.ips_total }} IPs across {{ geo.countries }} countries &middot; provider {{ geo.provider }} &middot; updated {{ geo.generated_at }} UTC.
  <br>Geolocation is approximate &mdash; hosting, VPN and cloud infrastructure regularly misrepresents the
  operator's true location. Treat this as context, not attribution.
</p>

<section>
  {% if geo.points %}
  <div id="map" role="img" aria-label="World map with circles sized by geolocated indicator count per country"></div>
  {% else %}
  <p class="muted">No geolocated indicators yet &mdash; the next sync will populate the map.</p>
  {% endif %}
</section>

{% if geo.points %}
<section>
  <h2>{{ ui.icon("target") }}By country</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th scope="col" class="num-col">#</th><th scope="col">Country</th><th scope="col" class="num-col">Indicators</th><th scope="col">Sample IPs</th></tr>
      </thead>
      <tbody>
      {% for c in geo.points %}
        <tr>
          <td class="num-cell">{{ loop.index }}</td>
          <td>{{ c.country }} ({{ c.cc | upper }})</td>
          <td class="num-cell">{{ c.count }}</td>
          <td>{% for ip in c.ips[:5] %}<code>{{ ip }}</code>{% if not loop.last %} {% endif %}{% endfor %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(function () {
  var points = {{ geo.points | tojson }};
  if (typeof L === "undefined" || !document.getElementById("map")) { return; }
  var map = L.map("map", { worldCopyJump: true, scrollWheelZoom: false }).setView([22, 10], 2);
  L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}", {
    maxZoom: 9,
    attribution: "Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ"
  }).addTo(map);
  points.forEach(function (c) {
    var radius = Math.max(6, Math.min(26, 6 + Math.log2(c.count + 1) * 4));
    var popup = "<strong>" + c.country + " (" + c.cc.toUpperCase() + ")</strong><br>" +
      c.count + " indicator(s)<br><code>" + c.ips.slice(0, 5).join("<br>") + "</code>";
    L.circleMarker([c.lat, c.lon], {
      radius: radius, color: "#00FF41", weight: 1, fillColor: "#00FF41", fillOpacity: 0.25
    }).addTo(map).bindPopup(popup);
  });
})();
</script>
{% endif %}
{% endblock %}
