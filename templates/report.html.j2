{% extends "base.html.j2" %}
{% import "_components.j2" as ui %}
{% block title %}Report {{ generated_date }} &mdash; Threat Intel Pipeline{% endblock %}
{% block content %}
<p class="muted">Window: last {{ window_days }} days &middot; Generated: {{ generated_at }} UTC</p>

{{ ui.cards(totals, feed_health, tor, window_days) }}

{{ ui.feed_health_section(feed_health) }}

<section>
  <h2>{{ ui.icon("database") }}Indicators by type</h2>
  {{ ui.bars(by_type, window_days) }}
</section>

<section>
  <h2>{{ ui.icon("list") }}Indicators by source</h2>
  {% if by_source %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th scope="col">Source</th><th scope="col" class="num-col">Indicators</th></tr>
      </thead>
      <tbody>
      {% for s in by_source %}
        <tr><td><code>{{ s.source }}</code></td><td class="num-cell">{{ s.count }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p class="muted">No source data.</p>
  {% endif %}
</section>

{{ ui.families_section(families) }}

{{ ui.attack_section(coverage) }}

{{ ui.tor_section(tor) }}

{{ ui.notable_section(notable) }}
{% endblock %}
