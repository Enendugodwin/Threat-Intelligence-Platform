# Copy to .env and fill in the values you need. The pipeline loads .env
# automatically for CLI commands; GitHub Actions uses repository secrets.

# Optional: AlienVault OTX feed (free account at https://otx.alienvault.com)
OTX_API_KEY=

# Required for URLhaus / ThreatFox / MalwareBazaar (abuse.ch retired keyless
# exports in 2026). Create a free key at https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# Optional: MISP connector (python -m tip push --misp)
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_SSL=true

# Optional: OpenCTI connector (python -m tip push --opencti) - experimental
OPENCTI_URL=
OPENCTI_TOKEN=
